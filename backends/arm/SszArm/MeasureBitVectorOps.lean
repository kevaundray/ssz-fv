namespace SszArm.Measure.BitVector

/-- A literal linked row, decoded by the accepted ARM decoder. -/
def checkedOp (position : Nat) (instructionWord : BitVec 32)
    (valid : (decode_raw_inst instructionWord).isSome = true)
    (member : (position, instructionWord) ∈ bodyProgram) : Result.Op :=
  { offset := position, word := instructionWord,
    instruction := (decode_raw_inst instructionWord).get valid, member := member,
    decoded := (Option.some_get valid).symm }

