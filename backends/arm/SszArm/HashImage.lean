def memcpyOffset : BitVec 64 := 136876#64
def memsetOffset : BitVec 64 := 136940#64

def RowsAt (s : ArmState) (base : BitVec 64) (rows : List (Nat × BitVec 32)) : Prop :=
  ∀ row ∈ rows, s.program.find? (base + BitVec.ofNat 64 row.1) = some row.2

structure CodeAt (s : ArmState) (base : BitVec 64) : Prop where
  compress : RowsAt s (base + compressOffset) compressProgram
  finalize : RowsAt s (base + finalizeOffset) finalizeProgram
  combine : RowsAt s base combineProgram
  memcpy : SszArm.CodeAt s (base + memcpyOffset) Memcpy.program
  memset : SszArm.CodeAt s (base + memsetOffset) Memset.program

theorem CodeAt.of_program_eq {s t : ArmState} {base : BitVec 64}
    (code : CodeAt s base) (same : t.program = s.program) : CodeAt t base := by
  rcases code with ⟨hc, hf, hb, hm, hz⟩
  constructor
  · simpa only [RowsAt, same] using hc
  · simpa only [RowsAt, same] using hf
  · simpa only [RowsAt, same] using hb
  · simpa only [SszArm.CodeAt, same] using hm
  · simpa only [SszArm.CodeAt, same] using hz

end SszArm.Hash
