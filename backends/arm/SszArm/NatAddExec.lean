namespace SszArm.NatAdd

set_option maxRecDepth 32768
set_option maxHeartbeats 16000000

/-- Each row is executed against the word fetched from the frozen image. -/
theorem step (s : ArmState) (base : BitVec 64) (op : Op)
    (hc : CodeAt s base) (hp : read_pc s = base + BitVec.ofNat 64 op.row.1)
    (he : read_err s = .None) (ha : CheckSPAlignment s) : stepi s = op.effect base s := by
  have hf : s.program.find? (read_pc s) = some op.row.2 := by
    rw [hp]
    exact hc op.row op.mem_program
  cases op
  case p0 => exact word_p0 s base he ha hf hp
  case p4 => exact word_p4 s base he ha hf
  case p8 => exact word_p8 s base he ha hf
  case p12 => exact word_p12 s base he ha hf
