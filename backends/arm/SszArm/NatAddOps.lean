/-- Every operation names an actual word of the bound image. -/
theorem Op.mem_program (op : Op) : op.row ∈ program := by
  cases op <;> decide

def next (s : ArmState) : ArmState := w .PC (read_pc s + 4#64) s

def put (reg : BitVec 5) (value : BitVec 64) (s : ArmState) : ArmState :=
  w (.GPR reg) value (next s)

/-- Exact architectural effects, including flags and the lowered scratch spills. -/
def Op.effect (base : BitVec 64) : Op → ArmState → ArmState
  | .p0, s => w .PC (if (r (.GPR 1#5) s) = 0#64 then base + 72#64 else base + 4#64) s
  | .p4, s => put 8 ((r (.GPR 1#5) s) - (8#64)) s
  | .p8, s => put 10 (r (.GPR 2#5) s) s
  | .p12, s => put 9 (r (.GPR 10#5) s) s
  | .p16, s => w .PC (if (r (.GPR 10#5) s) = 0#64 then base + 88#64 else base + 20#64) s
  | .p20, s => put 31 ((r (.GPR 31#5) s) - (16#64)) s
  | .p24, s => next (write_mem_bytes 8 (r (.GPR 31#5) s) (r (.GPR 10#5) s) s)
  | .p28, s => put 10 (r (.GPR 9#5) s) s
  | .p32, s => put 10 ((r (.GPR 10#5) s) <<< 3) s
  | .p36, s => put 10 ((r (.GPR 8#5) s) + (r (.GPR 10#5) s)) s
  | .p40, s => put 11 (read_mem_bytes 8 (r (.GPR 10#5) s) s) s
  | .p44, s => put 10 (read_mem_bytes 8 (r (.GPR 31#5) s) s) s
  | .p48, s => put 31 ((r (.GPR 31#5) s) + (16#64)) s
  | .p52, s => put 10 ((r (.GPR 9#5) s) - (1#64)) s
  | .p56, s => w .PC (if (r (.GPR 11#5) s) = 0#64 then base + 12#64 else base + 60#64) s
  | .p60, s => put 8 ((r (.GPR 10#5) s) + (1#64)) s
  | .p64, s => w .PC (if (r (.GPR 3#5) s) ≠ 0#64 then base + 300#64 else base + 68#64) s
  | .p68, s => w .PC (base + 96#64) s
  | .p72, s => w .PC (if (r (.GPR 2#5) s) = 0#64 then base + 292#64 else base + 76#64) s
  | .p76, s => w .PC (if (r (.GPR 3#5) s) = 0#64 then base + 540#64 else base + 80#64) s
  | .p80, s => put 8 (1#64) s
  | .p84, s => w .PC (base + 300#64) s
  | .p88, s => put 8 (0#64) s
  | .p92, s => w .PC (if (r (.GPR 3#5) s) ≠ 0#64 then base + 300#64 else base + 96#64) s
  | .p96, s => w .PC (if (r (.GPR 4#5) s) = 0#64 then base + 572#64 else base + 100#64) s
  | .p100, s => put 3 (0#64) s
  | .p104, s => w .PC (if (r (.GPR 9#5) s) = 0#64 then base + 492#64 else base + 108#64) s
  | .p108, s => put 9 (0#64) s
  | .p112, s => put 10 (1#64) s
