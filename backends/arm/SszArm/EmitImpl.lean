/-- Composite and panic frontiers, excluded by the primitive successful-call proof. -/
def frontiers : List Nat := [740, 1916, 1928, 1944, 1960, 1972, 1984]

def memcpyProgram : List (Nat × BitVec 32) :=
  Memcpy.program.zipIdx |>.map (fun (word, index) => (4 * index, word))

def program : List (Nat × BitVec 32) :=
  bodyProgram ++ memcpyProgram.map (fun row => (memcpyOffset + row.1, row.2))

def CodeAt (s : ArmState) (base : BitVec 64) : Prop :=
  ∀ row ∈ program, s.program.find? (base + BitVec.ofNat 64 row.1) = some row.2

theorem body_codeAt {s : ArmState} {base : BitVec 64} (code : CodeAt s base)
    (row : Nat × BitVec 32) (member : row ∈ bodyProgram) :
    s.program.find? (base + BitVec.ofNat 64 row.1) = some row.2 :=
  code row (List.mem_append.mpr (Or.inl member))

theorem memcpy_codeAt {s : ArmState} {base : BitVec 64} (code : CodeAt s base) :
    SszArm.CodeAt s (base + BitVec.ofNat 64 memcpyOffset) Memcpy.program := by
  have rows : ∀ i : Fin Memcpy.program.length,
      (memcpyOffset + 4 * i.val, Memcpy.program[i.val]) ∈ program := by decide
  intro index bound
  have found := code _ (rows ⟨index, bound⟩)
  simpa only [BitVec.ofNat_add, BitVec.add_assoc] using found

end SszArm.Emit
