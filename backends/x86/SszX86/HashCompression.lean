def roundsAddress (root : Int64) : BitVec 64 := (root + Int64.ofInt (-74024)).toBitVec

/-- Actual linked read-only table bytes, not a semantic assumption. -/
def TablesAt (m : DataMem) (root : Int64) : Prop :=
  BytesAt m (initialAddress root) initialBytes ∧
  BytesAt m (roundsAddress root) roundsBytes

def TablesPhysical (root : Int64) : Prop :=
  Physical (initialAddress root) 32 ∧ Physical (roundsAddress root) 256

def TablesDisjoint (root : Int64) (p : BitVec 64) (n : Nat) : Prop :=
  Disjoint (initialAddress root) p 32 n ∧ Disjoint (roundsAddress root) p 256 n

/-- The only writable compression allocations are its chaining state and stack. -/
def CompressionWritable (s : MachineData) (a : BitVec 64) : Prop :=
  InSpan a s.regs.rdi.toBitVec 32 ∨ InSpan a (s.regs.rsp.toBitVec - 160) 160

/-- Every premise is an observation of the actual helper's initial machine state. -/
structure CompressionPre (e : Executable) (root : Int64) (s : MachineData)
    (chaining : Vector UInt32 8) (block : Vector UInt8 64) (ra : BitVec 64) : Prop where
  code : Compress.CodeAt e (root - 912)
  state : ChainingAt s.dmem s.regs.rdi.toBitVec chaining
  block : BytesAt s.dmem s.regs.rsi.toBitVec block.toList
  tables : TablesAt s.dmem root
  statePhysical : Physical s.regs.rdi.toBitVec 32
  blockPhysical : Physical s.regs.rsi.toBitVec 64
  tablePhysical : TablesPhysical root
  stack : StackAt s.dmem s.regs.rsp.toBitVec 160
  returnSlot : ReturnAt s ra
  stateBlock : Disjoint s.regs.rdi.toBitVec s.regs.rsi.toBitVec 32 64
  stackState : Disjoint (s.regs.rsp.toBitVec - 160) s.regs.rdi.toBitVec 168 32
  stackBlock : Disjoint (s.regs.rsp.toBitVec - 160) s.regs.rsi.toBitVec 160 64
  tablesState : TablesDisjoint root s.regs.rdi.toBitVec 32
  tablesStack : TablesDisjoint root (s.regs.rsp.toBitVec - 160) 160

structure CompressionPost (s : MachineData) (chaining : Vector UInt32 8)
    (block : Vector UInt8 64) (ra : BitVec 64) (t : MachineState) : Prop where
  returned : Returned s ra t
  state : ChainingAt t.1.dmem s.regs.rdi.toBitVec
    (SszNative.HashStream.compressBuffer chaining block)
  frame : MemoryFrame s.dmem t.1.dmem (CompressionWritable s)
  stack : StackAt t.1.dmem s.regs.rsp.toBitVec 160

/-- Explicit trusted boundary for the real linked compression entry only. No
wrapper, padding, copying, branch, loop, or future memory fact is assumed. -/
def CompressionCorrect (e : Executable) (root : Int64) : Prop :=
  ∀ (s : MachineData) (chaining : Vector UInt32 8) (block : Vector UInt8 64) (ra : BitVec 64),
    CompressionPre e root s chaining block ra →
    Eventually (step e) (CompressionPost s chaining block ra) (s, root - 912)

end SszX86.Hash
